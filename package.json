{
    "name": "wasmoon-lua5.1",
    "version": "1.18.11",
    "description": "A real lua 5.1 VM with JS bindings made with webassembly",
    "main": "dist/index.js",
    "scripts": {
        "build:wasm:dev": "./build.sh dev",
        "build:wasm": "./build.sh",
        "build:wasm:docker:dev": "docker run --rm -v $(pwd):/wasmoon emscripten/emsdk /wasmoon/build.sh dev",
        "build:wasm:docker": "docker run --rm -v $(pwd):/wasmoon emscripten/emsdk /wasmoon/build.sh",
        "start": "tsdown --watch",
        "test": "mocha --parallel --require ./test/boot.js test/*.test.js",
        "build": "tsdown",
        "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\"",
        "lint": "prettier --write . && eslint . --fix --cache",
        "lint:nofix": "eslint .",
        "typecheck": "tsc --noEmit",
        "test:package": "node scripts/test-package.mjs"
    },
    "files": [
        "bin/*",
        "dist/*"
    ],
    "bin": {
        "wasmoon": "bin/wasmoon"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JX3BOX/wasmoon-lua5.1.git"
    },
    "author": "x3zvawq",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/JX3BOX/wasmoon-lua5.1/issues"
    },
    "homepage": "https://github.com/JX3BOX/wasmoon-lua5.1#readme",
    "keywords": [
        "lua",
        "lua5.1",
        "lua-bindings",
        "wasm",
        "webassembly"
    ],
    "devDependencies": {
        "@types/lodash": "^4.14.202",
        "@types/node": "24.19.1",
        "@typescript-eslint/eslint-plugin": "6.13.2",
        "@typescript-eslint/parser": "6.13.2",
        "chai": "4.3.10",
        "chai-as-promised": "7.1.1",
        "eslint": "8.55.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-prettier": "5.0.1",
        "eslint-plugin-sort-imports-es6-autofix": "0.6.0",
        "fengari": "0.1.4",
        "jest-mock": "29.7.0",
        "mocha": "10.2.0",
        "prettier": "3.1.0",
        "tsdown": "0.23.0",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "lodash": "^4.17.21"
    },
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./dist/liblua5.1.wasm": "./dist/liblua5.1.wasm",
        "./package.json": "./package.json"
    }
}
